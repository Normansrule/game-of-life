{
  "name": "life-tree-desktop",
  "productName": "Life Tree",
  "version": "7.1.0",
  "description": "Conway's Game of Life explorer: lineage trees, the math behind it and real-world applications.",
  "main": "main.cjs",
  "author": "Normansrule",
  "license": "MIT",
  "private": true,
  "scripts": {
    "copy-web": "node scripts/copy-web.cjs",
    "start": "npm run copy-web && electron .",
    "dist": "npm run copy-web && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.normansrule.lifetree",
    "productName": "Life Tree",
    "artifactName": "Life-Tree-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "web/**/*",
      "build/icon.png"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "syncDesktopName": true,
      "maintainer": "Normansrule"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "Life-Tree-${version}-win-${arch}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.education"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Normansrule",
        "repo": "game-of-life",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Normansrule/game-of-life.git"
  },
  "homepage": "https://normansrule.github.io/game-of-life/",
  "desktopName": "life-tree.desktop"
}
